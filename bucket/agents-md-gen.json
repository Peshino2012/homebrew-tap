{
    "version": "0.13.0",
    "description": "Generate a solid AGENTS.md/CLAUDE.md for any repo by detecting its stack, commands, and structure",
    "homepage": "https://www.npmjs.com/package/agents-md-gen",
    "license": "MIT",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/agents-md-gen/-/agents-md-gen-0.13.0.tgz",
    "hash": "sha256:4748b74ad22c1285a5994d5718d7320e9768b2e65effc1a52a0961dbe8d9d4d9",
    "extract_dir": "package",
    "pre_install": [
        "Set-Content -Path \"$dir\\agents-md-gen.cmd\" -Value \"@echo off`r`nnode `\"%~dp0bin\\cli.js`\" %*\" -Encoding Ascii"
    ],
    "bin": "agents-md-gen.cmd",
    "checkver": {
        "url": "https://registry.npmjs.org/agents-md-gen/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/agents-md-gen/-/agents-md-gen-$version.tgz"
    }
}
